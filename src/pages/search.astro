---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SELF_URL } from '../lib/network';

// Pagefind builds its index from dist/ after `astro build`, so the UI assets at
// /pagefind/ exist in production builds and previews but not in `astro dev`.
const searchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LitRPG Critic',
  url: SELF_URL,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SELF_URL}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Search"
  description="Search every article on LitRPG Critic — reviews, ranked lists, genre guides, and roundups."
  schema={[searchSchema]}
  noindex
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Search' }]} />
    <h1 class="mt-5 text-3xl font-bold text-white">Search</h1>
    <p class="mt-3 text-[#999]">Search every review, ranked list, genre explainer, and roundup on this site.</p>

    <div id="search" class="mt-8"></div>

    <noscript>
      <p class="mt-6 rounded border border-[var(--color-border)] bg-[var(--color-surface-2)] p-4 text-sm text-[#bbb]">
        Search needs JavaScript. You can still browse
        <a href="/tags/" class="text-[var(--color-brand)] underline underline-offset-4">every topic</a>
        or the <a href="/blog/" class="text-[var(--color-brand)] underline underline-offset-4">full article index</a>.
      </p>
    </noscript>

    <p class="mt-10 border-t border-[var(--color-border)] pt-5 text-sm text-[var(--color-text-muted)]">
      Looking for something broader? Browse
      <a href="/tags/" class="text-[var(--color-brand)] underline underline-offset-4 hover:text-white">all topics</a>.
    </p>
  </div>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    if (!window.PagefindUI) return;
    new window.PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      excerptLength: 24,
      resetStyles: false,
    });
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    if (q) {
      var input = document.querySelector('#search input');
      if (input) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  });
</script>

<style is:global>
  /* Pagefind ships light-theme defaults; map them onto the site palette. */
  #search {
    --pagefind-ui-primary: var(--color-brand);
    --pagefind-ui-text: #e8e8e8;
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: inherit;
  }
  #search .pagefind-ui__result-link { color: #fff; }
  #search .pagefind-ui__result-excerpt { color: #999; }
  #search mark { background: transparent; color: var(--color-brand); font-weight: 600; }
</style>
