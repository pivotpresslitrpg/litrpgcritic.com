---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedBooks from '../../components/RelatedBooks.astro';
import PublisherDisclosure from '../../components/PublisherDisclosure.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ProfessionalCTA from '../../components/ProfessionalCTA.astro';
import SisterSiteNote from '../../components/SisterSiteNote.astro';
import { ctaModeFor } from '../../lib/professionals';
import { buildTagIndex, tagSlug } from '../../lib/tags';
import { getBooks, platformUrl } from '../../lib/api';
import { findPivotPressAffiliations, PIVOT_PRESS_BASE, PIVOT_PRESS_NAME } from '../../lib/publisher';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const today = new Date().toISOString().slice(0, 10);
  const posts = (await getCollection('blog')).filter(p => p.data.date <= today);
  // Fetch one shared top-rated pool for every post's related-books module so the
  // build makes a single feed call instead of one per post.
  const relatedPool = await getBooks({ sort: 'top_rated', limit: 60 });
  // Only tags that clear the hub threshold get a chip, so no chip ever 404s.
  const hubTags = new Map(buildTagIndex(posts).map((t) => [t.slug, t.name]));
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, relatedPool, hubTags }
  }));
}

const { post, relatedPool, hubTags } = Astro.props;
const postTags = (post.data.tags ?? [])
  .map((t: string) => ({ name: t, slug: tagSlug(t) }))
  .filter((t) => hubTags.has(t.slug));
const { Content } = await render(post);

const dateStr = new Date(post.data.date + 'T12:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// `updated` is optional frontmatter. When present it drives schema dateModified
// and a visible "Updated" line, so refreshed evergreen posts stop advertising
// their original publication date as their last touch.
const updatedStr = post.data.updated
  ? new Date(post.data.updated + 'T12:00:00').toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric'
    })
  : null;
const modifiedISO = new Date((post.data.updated ?? post.data.date) + 'T12:00:00').toISOString();
const ctaMode = ctaModeFor(post.data.tags, post.data.title);
const pubDateISO = new Date(post.data.date + 'T12:00:00').toISOString();
const isBookReport = post.data.type === 'book_report';
const pivotAffiliations = findPivotPressAffiliations([
  post.data.title,
  post.data.description,
  ...post.data.tags,
  post.body,
]);
const pivotPressOrganization = {
  "@type": "Organization",
  "name": PIVOT_PRESS_NAME,
  "url": PIVOT_PRESS_BASE,
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": isBookReport ? "Review" : "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": pubDateISO,
  "dateModified": modifiedISO,
  "author": {
    "@type": "Organization",
    "name": "The LitRPG Critic",
    "url": "https://litrpgcritic.com/about",
    "parentOrganization": pivotPressOrganization,
  },
  "publisher": pivotPressOrganization,
  "isPartOf": { "@type": "WebSite", "name": "LitRPG Critic", "url": "https://litrpgcritic.com" },
  ...(isBookReport ? {
    "itemReviewed": {
      "@type": "Book",
      "name": post.data.title.replace(/^(Review:\s*|Book Report:\s*)/i, '')
    }
  } : {})
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litrpgcritic.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://litrpgcritic.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": post.data.title }
  ]
};

const faqSchema = post.data.faq?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map(({ q, a }: { q: string; a: string }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
} : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedDate={post.data.date}
  schema={[articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <Breadcrumbs items={[
      { name: 'Home', href: '/' },
      { name: 'Blog', href: '/blog/' },
      { name: post.data.title },
    ]} />
    <div class="mt-5 mb-6">
      {post.data.type && (
        <span class="text-xs font-semibold text-[#e85d2f] uppercase tracking-wider">{post.data.type.replace(/_/g, ' ')}</span>
      )}
      <h1 class="text-3xl sm:text-4xl font-bold text-white mt-2 leading-tight">{post.data.title}</h1>
      <p class="text-[#888] mt-2 text-sm">
        {dateStr}{updatedStr && <span> &middot; Updated {updatedStr}</span>}
      </p>
    </div>
    <PublisherDisclosure matches={pivotAffiliations} />
    <div class="prose">
      <Content />
    </div>

    <SisterSiteNote tags={post.data.tags} title={post.data.title} />

    <!-- FAQ pairs render as readable text here; the page also emits FAQPage JSON-LD. -->
    <FaqBlock items={post.data.faq} />

    {postTags.length > 0 && (
      <nav aria-label="Topics" class="mt-10 flex flex-wrap items-center gap-2">
        <span class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Topics</span>
        {postTags.map((tag) => (
          <a
            href={`/tags/${tag.slug}/`}
            class="rounded border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-xs text-[#bbb] transition-colors hover:border-[var(--color-brand)] hover:text-white"
          >{tag.name}</a>
        ))}
      </nav>
    )}

    <!-- Related books → platform book pages -->
    <RelatedBooks pool={relatedPool} tags={post.data.tags} />

    <!-- One closing CTA only: the contextual recruitment block on posts about the
         professional side of the genre, the general reader CTA everywhere else. -->
    {ctaMode === 'community' ? (
      <div class="mt-12 p-6 bg-[#1a1a1a] border border-[#2e2e2e] rounded-lg text-center">
        <p class="text-white font-semibold mb-2">Discover more LitRPG & progression fantasy</p>
        <p class="text-[#888] text-sm mb-4">Browse thousands of ranked books, track new releases, and find your next read.</p>
        <a href={platformUrl('post-cta')} target="_blank" rel="noopener" class="inline-block bg-[#e85d2f] hover:bg-[#c44a1f] text-white px-6 py-2.5 rounded font-medium transition-colors">
          Explore LitRPGTools.com &rarr;
        </a>
      </div>
    ) : (
      <ProfessionalCTA mode={ctaMode} surface="post" />
    )}
  </article>
</BaseLayout>
