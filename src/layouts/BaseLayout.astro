---
import '../styles/global.css';
import { platformUrl } from '../lib/api';
import { pivotPressUrl } from '../lib/publisher';
import { SISTER_SITES } from '../lib/network';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  publishedDate?: string;
  schema?: object | object[];
  /** Keep a utility page out of the index without hiding it from crawlers. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedDate,
  schema,
  noindex = false
} = Astro.props;

const fullTitle = title.includes('LitRPG Critic') ? title : `${title} | LitRPG Critic`;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="msvalidate.01" content="7EE57625642C0FDAD06C3D07915EBF09" />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="LitRPG Critic" />
  {ogType === 'article' && publishedDate && <meta property="article:published_time" content={publishedDate} />}
  {ogType === 'article' && <meta property="article:author" content="LitRPG Critic" />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

  <!-- Author & Citation -->
  <meta name="author" content="LitRPG Critic" />
  <meta name="citation_title" content={fullTitle} />
  <meta name="citation_author" content="LitRPG Critic" />
  {publishedDate && <meta name="citation_publication_date" content={publishedDate} />}

  <!-- Sitemap & RSS -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="LitRPG Critic" href="/rss.xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Plausible Analytics -->
  <script async src="https://plausible.io/js/pa-JqwU4slIe-Luwi-mjmm2I.js"></script>
  <script>
    window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
  </script>

  <!-- JSON-LD Schema -->
  {schemas.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <!-- Additional head content (e.g. extra JSON-LD schemas) -->
  <slot name="head-extra" />
</head>
<body class="min-h-screen flex flex-col">
  <!-- Nav -->
  <header data-pagefind-ignore class="border-b border-[var(--color-border)] sticky top-0 z-50 bg-[var(--color-surface)]/95 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight">
        <span class="text-[var(--color-brand)]">LitRPG</span><span class="text-white">Critic</span>
      </a>
      <nav class="hidden sm:flex items-center gap-6 text-sm text-[var(--color-text-muted)]">
        <a href="/lists/" class="hover:text-white transition-colors">Lists</a>
        <a href="/new-releases/" class="hover:text-white transition-colors">New Releases</a>
        <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
        <a href="/for-professionals/" class="hover:text-white transition-colors">Professionals</a>
        <a href="/about/" class="hover:text-white transition-colors">About</a>
        <a href="/search/" aria-label="Search" class="hover:text-white transition-colors">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
          </svg>
        </a>
        <a href={platformUrl('nav')} target="_blank" rel="noopener" class="ml-2 px-3 py-1.5 text-xs font-semibold rounded bg-[var(--color-brand)] text-white hover:opacity-90 transition-opacity">Explore LitRPGTools &rarr;</a>
      </nav>
      <button id="mobile-menu-btn" class="sm:hidden text-[var(--color-text-muted)]" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div id="mobile-menu" data-pagefind-ignore class="fixed inset-0 z-[60] hidden">
    <div id="mobile-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div id="mobile-panel" class="absolute right-0 top-0 h-full w-64 bg-[var(--color-surface)] border-l border-[var(--color-border)] p-6 flex flex-col">
      <button id="mobile-close" class="self-end text-[var(--color-text-muted)] hover:text-white mb-6" aria-label="Close menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
        </svg>
      </button>
      <nav class="flex flex-col gap-4 text-sm text-[var(--color-text-muted)]">
        <a href="/lists/" class="hover:text-white transition-colors">Lists</a>
        <a href="/new-releases/" class="hover:text-white transition-colors">New Releases</a>
        <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
        <a href="/search/" class="hover:text-white transition-colors">Search</a>
        <a href="/for-professionals/" class="hover:text-white transition-colors">Professionals</a>
        <a href="/about/" class="hover:text-white transition-colors">About</a>
      </nav>
      <div class="mt-auto pt-6 border-t border-[var(--color-border)]">
        <a href={platformUrl('nav-mobile')} target="_blank" rel="noopener" class="block text-center px-4 py-2 text-sm font-semibold rounded bg-[var(--color-brand)] text-white hover:opacity-90 transition-opacity">Explore LitRPGTools &rarr;</a>
      </div>
    </div>
  </div>

  <!-- Main -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer data-pagefind-ignore class="border-t border-[var(--color-border)] mt-16 py-10 text-[var(--color-text-muted)] text-sm">
    <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row justify-between gap-6">
      <div>
        <p class="font-semibold text-white mb-1">
          <span class="text-[var(--color-brand)]">LitRPG</span>Critic
        </p>
        <p class="max-w-xs">Editorial rankings and reviews for LitRPG &amp; progression fantasy readers.</p>
      </div>
      <div class="flex flex-wrap gap-x-10 gap-y-6">
        <nav class="flex flex-col gap-1">
          <p class="text-white font-semibold mb-1">Site</p>
          <a href="/lists/" class="hover:text-white transition-colors">Lists</a>
          <a href="/new-releases/" class="hover:text-white transition-colors">New Releases</a>
          <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
          <a href="/tags/" class="hover:text-white transition-colors">Topics</a>
          <a href="/search/" class="hover:text-white transition-colors">Search</a>
        </nav>
        <nav class="flex flex-col gap-1">
          <p class="text-white font-semibold mb-1">Info</p>
          <a href="/about/" class="hover:text-white transition-colors">About</a>
          <a href="/editorial/" class="hover:text-white transition-colors">Editorial standards</a>
          <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
          <a href="/privacy/" class="hover:text-white transition-colors">Privacy</a>
          <a href="/rss.xml" class="hover:text-white transition-colors">RSS</a>
        </nav>
        <nav class="flex flex-col gap-1">
          <p class="text-white font-semibold mb-1">Platform</p>
          <a href={platformUrl('footer')} target="_blank" rel="noopener" class="hover:text-white transition-colors">LitRPGTools.com</a>
          <a href="/for-professionals/" class="hover:text-white transition-colors">For professionals</a>
        </nav>
        <nav class="flex flex-col gap-1">
          <p class="text-white font-semibold mb-1">Sister sites</p>
          {SISTER_SITES.map((s) => (
            <a href={s.url} rel="noopener" class="hover:text-white transition-colors">{s.name}</a>
          ))}
        </nav>
      </div>
    </div>
    <div class="max-w-5xl mx-auto px-4 mt-6 pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row gap-3 justify-between">
      <p>
        Owned and operated by <a href={pivotPressUrl('footer-ownership')} class="hover:text-white underline" target="_blank" rel="noopener">Pivot Press Publishing</a>.
        Book data sourced from <a href={platformUrl('footer-attribution')} class="hover:text-white underline" target="_blank" rel="noopener">LitRPGTools.com</a>.
        Amazon links may be affiliate links.
      </p>
      <p>&copy; {new Date().getFullYear()} LitRPG Critic</p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const close = document.getElementById('mobile-close');
    const backdrop = document.getElementById('mobile-backdrop');
    const panel = document.getElementById('mobile-panel');

    function focusables(): HTMLElement[] {
      return panel ? Array.from(panel.querySelectorAll<HTMLElement>('a[href], button')) : [];
    }
    function isOpen() { return menu ? !menu.classList.contains('hidden') : false; }
    function openMenu() {
      menu?.classList.remove('hidden');
      btn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      focusables()[0]?.focus();
    }
    function closeMenu() {
      if (!isOpen()) return;
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      btn?.focus();
    }
    btn?.addEventListener('click', openMenu);
    close?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);
    // Escape closes; Tab cycles inside the panel so keyboard users are not stranded.
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { closeMenu(); return; }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  </script>

  <!-- AI-assistant referral segmentation.
       Answer engines send traffic that ordinary referrer reporting buries: some
       strip the referrer entirely and tag the URL instead (ChatGPT appends
       utm_source=chatgpt.com), others pass a referrer no report groups usefully.
       This fires one Plausible event naming the assistant so we can see which
       pages get cited, not just which ones rank. Sends a source label and the
       path only. -->
  <script is:inline>
    (function () {
      var SOURCES = [
        ['chatgpt.com', 'ChatGPT'],
        ['chat.openai.com', 'ChatGPT'],
        ['openai.com', 'ChatGPT'],
        ['perplexity.ai', 'Perplexity'],
        ['gemini.google.com', 'Gemini'],
        ['bard.google.com', 'Gemini'],
        ['copilot.microsoft.com', 'Copilot'],
        ['claude.ai', 'Claude'],
        ['poe.com', 'Poe'],
        ['you.com', 'You.com'],
        ['phind.com', 'Phind'],
        ['grok.com', 'Grok'],
        ['mistral.ai', 'Mistral'],
        ['deepseek.com', 'DeepSeek']
      ];

      function label(host) {
        if (!host) return '';
        for (var i = 0; i < SOURCES.length; i++) {
          var h = SOURCES[i][0];
          // Exact host, or a real subdomain of it. Compare the suffix directly:
          // an indexOf-vs-arithmetic check silently matches whenever the two
          // hostnames are the same length (google.com would read as openai.com).
          if (host === h || host.slice(-(h.length + 1)) === '.' + h) {
            return SOURCES[i][1];
          }
        }
        return '';
      }

      var source = '';
      try {
        var utm = (new URLSearchParams(location.search).get('utm_source') || '').toLowerCase();
        if (utm) source = label(utm.replace(/^www\./, ''));
        if (!source && document.referrer) {
          source = label(new URL(document.referrer).hostname.toLowerCase().replace(/^www\./, ''));
        }
      } catch (_) { return; }

      if (source && window.plausible) {
        window.plausible('AI Referral', { props: { source: source, page: location.pathname } });
      }
    })();
  </script>

  <!-- Outbound conversion tracking for the reader platform, publisher, and retailers. -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var el = e.target instanceof Element ? e.target.closest('a[href]') : null;
      if (!el || !window.plausible) return;

      var url;
      try { url = new URL(el.href, location.href); } catch (_) { return; }

      var hostname = url.hostname.toLowerCase().replace(/^www\./, '');
      var content = url.searchParams.get('utm_content') || el.getAttribute('data-analytics-content') || 'inline';
      var props = { content: content, page: location.pathname };

      if (hostname === 'litrpgtools.com' || hostname.endsWith('.litrpgtools.com')) {
        window.plausible('Platform Click', { props: props });
        return;
      }
      if (hostname === 'pivotpresspublishing.com' || hostname.endsWith('.pivotpresspublishing.com')) {
        window.plausible('Publisher Click', { props: props });
        return;
      }

      var retailer = '';
      if (hostname === 'amzn.to' || /(^|\.)amazon\.[a-z.]+$/.test(hostname)) retailer = 'Amazon';
      if (/(^|\.)audible\.[a-z.]+$/.test(hostname)) retailer = 'Audible';
      if (retailer) {
        window.plausible('Retailer Click', { props: { retailer: retailer, content: content, page: location.pathname } });
      }
    });
  </script>
</body>
</html>
