---
// Renders FAQ entries as readable text.
//
// These pairs previously existed only inside FAQPage JSON-LD, which meant no
// reader ever saw them and the answers never entered the visible prose layer
// that retrieval systems chunk and embed. The schema still ships from the page
// template; this component is the human- and extraction-facing half.
interface Props {
  items?: { q: string; a: string }[];
  heading?: string;
}

const { items = [], heading = 'Common questions' } = Astro.props;
---

{items.length > 0 && (
  <section class="mt-12 border-t border-[var(--color-border)] pt-8" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl font-bold text-white">{heading}</h2>
    <dl class="mt-5 flex flex-col gap-5">
      {items.map(({ q, a }) => (
        <div class="border-l-2 border-[var(--color-border)] pl-4">
          <dt class="text-[15px] font-semibold text-white leading-snug">{q}</dt>
          <dd class="mt-1.5 text-[15px] leading-relaxed text-[#bbb]">{a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
