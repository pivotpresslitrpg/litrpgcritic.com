---
// Contextual recruitment block. The register (hire / earn / create / community)
// is chosen from the post's own subject so an artist post never gets a beta
// reader pitch. Copy lives in lib/professionals.ts and is unique to this site.
import { CTA, ctaModeFor, professionalUrl, type CtaMode } from '../lib/professionals';

interface Props {
  mode?: CtaMode;
  tags?: string[];
  title?: string;
  /** Analytics label for the surface this instance sits on. */
  surface?: string;
}

const { mode, tags = [], title = '', surface = 'post' } = Astro.props;
const variant = CTA[mode ?? ctaModeFor(tags, title)];
const primaryHref = professionalUrl(variant.primary.path, `${variant.primary.content}-${surface}`);
const secondaryHref = professionalUrl(variant.secondary.path, `${variant.secondary.content}-${surface}`);
---

<aside class="mt-12 border-l-2 border-[var(--color-brand)] bg-[var(--color-surface-2)] rounded-r-lg px-6 py-6">
  <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-brand)]">
    {variant.eyebrow}
  </p>
  <h2 class="mt-2 text-lg sm:text-xl font-bold text-white leading-snug">
    {variant.heading}
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-[#bbb] max-w-2xl">
    {variant.body}
  </p>
  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
    <a
      href={primaryHref}
      target="_blank"
      rel="noopener"
      data-analytics-content={variant.primary.content}
      class="inline-flex items-center gap-1.5 rounded bg-[var(--color-brand)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-brand-dark)]"
    >
      {variant.primary.label} <span aria-hidden="true">&rarr;</span>
    </a>
    <a
      href={secondaryHref}
      target="_blank"
      rel="noopener"
      data-analytics-content={variant.secondary.content}
      class="text-sm text-[#999] underline underline-offset-4 transition-colors hover:text-white"
    >
      {variant.secondary.label}
    </a>
    <a
      href="/for-professionals/"
      class="text-sm text-[#999] underline underline-offset-4 transition-colors hover:text-white"
    >
      How the program works
    </a>
  </div>
</aside>
