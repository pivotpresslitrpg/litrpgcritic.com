---
// Visible breadcrumb trail. BreadcrumbList JSON-LD already shipped on article
// pages; this is the on-page counterpart so readers get a sense of place and
// the trail exists in extractable text rather than metadata alone.
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs text-[var(--color-text-muted)]">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-white">{item.name}</a>
        ) : (
          <span class="text-[#aaa]" aria-current="page">{item.name}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-[#444]">/</span>}
      </li>
    ))}
  </ol>
</nav>
